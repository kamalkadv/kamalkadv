<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- "Tombol" berupa LinearLayout (ikon + teks di tengah), karena Button bawaan platform
         menaruh drawableStart di tepi kiri, bukan di samping teks. -->
    <style name="KioskButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="KioskButton.Primary">
        <item name="android:background">@drawable/btn_primary</item>
    </style>
    <style name="KioskButton.Secondary">
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/btn_secondary</item>
    </style>
    <style name="KioskButton.Emergency" parent="KioskButton.Secondary">
        <item name="android:background">@drawable/btn_emergency</item>
    </style>
    <style name="KioskButtonIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="KioskButtonText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>
    <!-- Tombol teks biasa (tanpa ikon) di layar Wi-Fi. -->
    <style name="KioskTextButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/kiosk_on_surface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="KioskTextButton.Primary">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/kiosk_on_accent</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="KioskInfoLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/kiosk_muted</item>
    </style>
</resources>

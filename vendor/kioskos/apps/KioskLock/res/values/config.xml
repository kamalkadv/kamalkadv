<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nama perusahaan di layar kunci. Logo: drawable/brand_logo. Ganti lewat overlay produk. -->
    <string name="config_brand_name" translatable="false">KioskOS</string>

    <!-- Bisa di-override per produk dengan overlay (PRODUCT_PACKAGE_OVERLAYS). -->

    <!-- Base URL server lock. Wajib HTTPS. -->
    <string name="config_server_url" translatable="false">https://lock.example.com</string>

    <!-- Public key server (EC P-256, X.509 SubjectPublicKeyInfo, Base64, tanpa header PEM).
         Setiap respons server wajib ditandatangani; tanpa ini siapa pun yang bisa
         memalsukan DNS/server bisa membuka kunci perangkat. -->
    <string name="config_server_public_key" translatable="false">REPLACE_WITH_BASE64_PUBLIC_KEY</string>

    <!-- Interval sinkron ke server (menit, minimum 15). -->
    <integer name="config_sync_interval_minutes">15</integer>

    <!-- Blokir menu Factory Reset di Settings selama perangkat terdaftar. -->
    <bool name="config_block_factory_reset">true</bool>

    <!-- Hanya berlaku di build userdebug/eng: true = tetap matikan ADB saat terdaftar.
         Build "user" (produksi) SELALU mematikan ADB saat terdaftar. -->
    <bool name="config_block_debugging_on_debuggable_builds">false</bool>
</resources>

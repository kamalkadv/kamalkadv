<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView: di layar kecil, posisi mendatar, huruf besar, atau pesan panjang (maks. 500
     karakter dari server), semua isi tetap bisa dijangkau, terutama tombol Panggilan darurat.
     fillViewport + gravity center: jika isi muat, tetap di tengah layar seperti biasa. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#101418">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lock_title"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/lock_default_message"
        android:textColor="#DDDDDD"
        android:textSize="16sp"/>

    <TextView
        android:id="@+id/contact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="#8AB4F8"
        android:textSize="16sp"/>

    <TextView
        android:id="@+id/device_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="#888888"
        android:textSize="13sp"/>

    <!-- Aplikasi yang tetap boleh dibuka saat terkunci (diatur dari dashboard). -->
    <TextView
        android:id="@+id/apps_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/apps_label"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:visibility="gone"/>

    <GridLayout
        android:id="@+id/app_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:columnCount="4"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="#F28B82"
        android:textSize="14sp"/>

    <Button
        android:id="@+id/btn_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/btn_check"/>

    <Button
        android:id="@+id/btn_wifi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_wifi"/>

    <Button
        android:id="@+id/btn_emergency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_emergency"/>
</LinearLayout>
</ScrollView>

android_app {
    name: "KioskLock",
    // src/: kode bersama. src-aosp/: bagian yang butuh API sistem (FRP, setDeviceOwner,
    // WifiManager.connect). Edisi Device Owner (android-dpc/) memakai src-dpc/ sebagai gantinya.
    srcs: [
        "src/**/*.java",
        "src-aosp/**/*.java",
    ],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    static_libs: ["kioskos-common"],

    // Butuh hidden/system API: DevicePolicyManager.setDeviceOwner, PersistentDataBlockManager.
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,

    optimize: {
        enabled: false,
    },
}
